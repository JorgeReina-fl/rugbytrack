# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# compiled server artefacts (generated by pnpm build)
server.js
src/lib/*.js

# docker backup files
docker-compose.yml.bak.*

# user uploads (keep the directory, ignore its contents)
/public/uploads/*
!/public/uploads/.gitkeep

# one-off utility scripts (not part of the project)
replace_*.js
run_replace.js
table_output.json
