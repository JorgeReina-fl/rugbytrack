# =============================================================================
# RUGBYTRACK — Variables de entorno
# Copia este archivo a .env.local y rellena los valores reales.
# NUNCA subas .env.local al repositorio.
# =============================================================================

# -----------------------------------------------------------------------------
# BASE DE DATOS — PostgreSQL (Neon en prod, Docker en local)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# En producción usa sslmode=require (Neon lo requiere)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://rugbytrack:CHANGEPASSWORD@localhost:5432/rugbytrack_dev"

# -----------------------------------------------------------------------------
# BASE DE DATOS — MongoDB (Atlas free tier en prod, Docker en local)
# Formato local:  mongodb://USER:PASSWORD@localhost:27017/DATABASE?authSource=admin
# Formato Atlas:  mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DATABASE
# -----------------------------------------------------------------------------
MONGODB_URI="mongodb://rugbytrack:CHANGEPASSWORD@localhost:27017/rugbytrack_dev?authSource=admin"

# -----------------------------------------------------------------------------
# CACHE — Redis (Redis Cloud / Upstash en prod, Docker en local)
# Formato: redis://:PASSWORD@HOST:PORT
# -----------------------------------------------------------------------------
REDIS_URL="redis://:CHANGEPASSWORD@localhost:6379"

# -----------------------------------------------------------------------------
# AUTENTICACIÓN — NextAuth v5
# NEXTAUTH_SECRET: genera con: openssl rand -base64 32
# NEXTAUTH_URL: URL pública de tu app (sin barra final)
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_-base64_32"
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# APP — URL pública (usado para generar links de invitación)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# LOGGING
# Niveles: trace | debug | info | warn | error | fatal
# En producción usa: info
# -----------------------------------------------------------------------------
LOG_LEVEL="debug"

# -----------------------------------------------------------------------------
# DOCKER COMPOSE — Variables para los contenedores locales
# (solo necesarias si usas docker-compose.yml)
# -----------------------------------------------------------------------------
POSTGRES_USER="rugbytrack"
POSTGRES_PASSWORD="CHANGEPASSWORD"
POSTGRES_DB="rugbytrack_dev"

MONGO_USER="rugbytrack"
MONGO_PASSWORD="CHANGEPASSWORD"
MONGO_DB="rugbytrack_dev"

REDIS_PASSWORD="CHANGEPASSWORD"

# -----------------------------------------------------------------------------
# EMAIL — Resend (para envío de notificaciones de convocatoria y recordatorios)
# Obtén tu clave en: https://resend.com
# EMAIL_FROM requiere dominio verificado en Resend para enviar desde dominio propio.
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="RugbyTrack <rugbytrack@mivia.es>"

# -----------------------------------------------------------------------------
# PASSWORD RESET — @mivia/auth-reset
# AUTH_RESET_SECRET: firma HMAC de tokens de reset. Debe ser distinto de
# NEXTAUTH_SECRET (rotarlo invalida todos los tokens de reset en vuelo).
# Genera con: openssl rand -base64 32
# -----------------------------------------------------------------------------
AUTH_RESET_SECRET="CHANGE_ME_generate_with_openssl_rand_-base64_32"

# -----------------------------------------------------------------------------
# SMTP — Envío de emails de reset y notificaciones (mail.jorgereina.com)
# Cuenta creada en docker-mailserver (dominio mivia.es).
# Puerto 587 con STARTTLS. Nunca comitees las credenciales reales.
# -----------------------------------------------------------------------------
SMTP_HOST="mail.jorgereina.com"
SMTP_PORT="587"
SMTP_USER="rugbytrack@mivia.es"
SMTP_PASS="CHANGE_ME_password_de_la_cuenta_SMTP"

# -----------------------------------------------------------------------------
# CRON — Secret Token (para asegurar el endpoint /api/cron/reminders)
# Genera con: openssl rand -base64 32
# -----------------------------------------------------------------------------
CRON_SECRET="CHANGE_ME_generate_with_openssl_rand_-base64_32"

# -----------------------------------------------------------------------------
# WEBSOCKETS / SOCKET.IO
# NEXT_PUBLIC_WS_URL: URL del servidor de WebSockets (en local coincide con APP_URL)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_WS_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# IA — Google Gemini (para embeddings de jugadores y búsqueda semántica)
# Obtén tu clave en: https://aistudio.google.com/app/apikey
# Sin esta clave los embeddings usan vectores pseudo-aleatorios (solo desarrollo).
# -----------------------------------------------------------------------------
GEMINI_API_KEY="AIzaSy_your_real_key_here"

